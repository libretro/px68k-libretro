LIBRETRO_COMM_DIR := $(CORE_DIR)/libretro-common

SOURCES_S 		:=
SOURCES_C 		:=
SOURCES_CXX 	:=

INCFLAGS		:= -I$(CORE_DIR) -I$(CORE_DIR)/libretro-common/include -I$(CORE_DIR)/libretro
INCFLAGS 		+= -I$(CORE_DIR)/x68k \
			   -I$(CORE_DIR)/fmgen \
			   -I$(CORE_DIR)/libretro \
			   -I$(CORE_DIR)/m68000

SOURCES_C 		+= \
				$(CORE_DIR)/m68000/m68000.c

ifeq ($(CPU_RUNTIME),1)
FLAGS += -DHAVE_M68000 -DHAVE_MUSASHI -DHAVE_CPU_RUNTIME
SOURCES_C += \
                $(CORE_DIR)/m68000/m68k/c68k.c \
                $(CORE_DIR)/m68000/m68k/c68kexec.c \
                $(CORE_DIR)/m68000/musashi/m68kcpu.c \
                $(CORE_DIR)/m68000/musashi/m68kops.c \
                $(CORE_DIR)/m68000/musashi/softfloat/softfloat.c
else
ifeq ($(CYCLONE),1)
FLAGS += -DHAVE_CYCLONE
SOURCES_S += $(CORE_DIR)/m68000/cyclone.s
else
ifeq ($(M68000),1)
FLAGS += -DHAVE_M68000
SOURCES_C += $(CORE_DIR)/m68000/m68k/c68k.c $(CORE_DIR)/m68000/m68k/c68kexec.c
else
ifeq ($(C68K),1)
FLAGS += -DHAVE_C68K -DC68K_NO_JUMP_TABLE
SOURCES_C += $(CORE_DIR)/m68000/c68k/c68k.c $(CORE_DIR)/m68000/c68k/c68kexec.c
else
FLAGS += -DHAVE_MUSASHI
SOURCES_C += $(CORE_DIR)/m68000/musashi/m68kcpu.c $(CORE_DIR)/m68000/musashi/m68kops.c $(CORE_DIR)/m68000/musashi/softfloat/softfloat.c
endif
endif
endif
endif

SOURCES_C 		+= \
				$(CORE_DIR)/x68k/adpcm.c \
				$(CORE_DIR)/x68k/bg.c \
				$(CORE_DIR)/x68k/crtc.c \
				$(CORE_DIR)/x68k/dmac.c \
				$(CORE_DIR)/x68k/fdc.c \
				$(CORE_DIR)/x68k/fdd.c \
				$(CORE_DIR)/x68k/disk_d88.c \
				$(CORE_DIR)/x68k/disk_dim.c \
				$(CORE_DIR)/x68k/disk_xdf.c \
				$(CORE_DIR)/x68k/gvram.c \
				$(CORE_DIR)/x68k/ioc.c \
				$(CORE_DIR)/x68k/irqh.c \
				$(CORE_DIR)/x68k/mem_wrap.c \
				$(CORE_DIR)/x68k/mercury.c \
				$(CORE_DIR)/x68k/mfp.c \
				$(CORE_DIR)/x68k/palette.c \
				$(CORE_DIR)/x68k/midi.c \
				$(CORE_DIR)/x68k/pia.c \
				$(CORE_DIR)/x68k/rtc.c \
				$(CORE_DIR)/x68k/sasi.c \
				$(CORE_DIR)/x68k/scc.c \
				$(CORE_DIR)/x68k/scsi.c \
				$(CORE_DIR)/x68k/sram.c \
				$(CORE_DIR)/x68k/sysport.c \
				$(CORE_DIR)/x68k/tvram.c \
				$(CORE_DIR)/libretro/joystick.c \
				$(CORE_DIR)/libretro/keyboard.c \
				$(CORE_DIR)/libretro/mouse.c \
				$(CORE_DIR)/libretro/prop.c \
				$(CORE_DIR)/libretro/timer.c \
				$(CORE_DIR)/libretro/dswin.c \
				$(CORE_DIR)/libretro/windraw.c \
				$(CORE_DIR)/libretro/winui.c \
				$(CORE_DIR)/libretro/dosio.c \
				$(CORE_DIR)/libretro/fake.c \
				$(CORE_DIR)/libretro/peace.c \
				$(CORE_DIR)/libretro/zipdisk.c \
				$(CORE_DIR)/libretro/state.c \
				$(CORE_DIR)/midi/midi_shadow.c \
				$(CORE_DIR)/midi/sc55/sc55.c \
				$(CORE_DIR)/midi/midiemu/midiemu_libretro.c \
				$(CORE_DIR)/libretro.c

SOURCES_CXX 	+= \
				$(CORE_DIR)/fmgen/fmg_wrap.cpp \
				$(CORE_DIR)/fmgen/fmgen.cpp \
				$(CORE_DIR)/fmgen/fmtimer.cpp \
				$(CORE_DIR)/fmgen/opm.cpp \
				$(CORE_DIR)/fmgen/opna.cpp \
				$(CORE_DIR)/fmgen/psg.cpp \
				$(CORE_DIR)/midi/mt32emu/mt32emu_libretro.cpp


# Bundled Munt MT-32/CM-32L synthesizer (LGPL-2.1-or-later).
MUNT_DIR := $(CORE_DIR)/midi/mt32emu/munt/mt32emu
FLAGS += -DMT32EMU_WITH_INTERNAL_RESAMPLER -DMT32EMU_FASTER_MATH=1
INCFLAGS += -I$(CORE_DIR)/midi/sc55 -I$(CORE_DIR)/midi/midiemu -I$(CORE_DIR)/midi/mt32emu -I$(MUNT_DIR)/src -I$(MUNT_DIR)/src/srchelper -I$(MUNT_DIR)/src/srchelper/srctools/include
SOURCES_CXX += \
                $(MUNT_DIR)/src/Analog.cpp \
                $(MUNT_DIR)/src/BReverbModel.cpp \
                $(MUNT_DIR)/src/Display.cpp \
                $(MUNT_DIR)/src/File.cpp \
                $(MUNT_DIR)/src/FileStream.cpp \
                $(MUNT_DIR)/src/LA32FloatWaveGenerator.cpp \
                $(MUNT_DIR)/src/LA32Ramp.cpp \
                $(MUNT_DIR)/src/LA32WaveGenerator.cpp \
                $(MUNT_DIR)/src/MidiStreamParser.cpp \
                $(MUNT_DIR)/src/Part.cpp \
                $(MUNT_DIR)/src/Partial.cpp \
                $(MUNT_DIR)/src/PartialManager.cpp \
                $(MUNT_DIR)/src/Poly.cpp \
                $(MUNT_DIR)/src/ROMInfo.cpp \
                $(MUNT_DIR)/src/Synth.cpp \
                $(MUNT_DIR)/src/Tables.cpp \
                $(MUNT_DIR)/src/TVA.cpp \
                $(MUNT_DIR)/src/TVF.cpp \
                $(MUNT_DIR)/src/TVP.cpp \
                $(MUNT_DIR)/src/sha1/sha1.cpp \
                $(MUNT_DIR)/src/SampleRateConverter.cpp \
                $(MUNT_DIR)/src/c_interface/c_interface.cpp \
                $(MUNT_DIR)/src/srchelper/srctools/src/FIRResampler.cpp \
                $(MUNT_DIR)/src/srchelper/srctools/src/SincResampler.cpp \
                $(MUNT_DIR)/src/srchelper/srctools/src/IIR2xResampler.cpp \
                $(MUNT_DIR)/src/srchelper/srctools/src/LinearResampler.cpp \
                $(MUNT_DIR)/src/srchelper/srctools/src/ResamplerModel.cpp \
                $(MUNT_DIR)/src/srchelper/InternalResampler.cpp

ifeq ($(USE_LIBRETRO_VFS),1)
SOURCES_C 		+= \
				$(LIBRETRO_COMM_DIR)/compat/compat_posix_string.c \
				$(LIBRETRO_COMM_DIR)/compat/compat_strcasestr.c \
				$(LIBRETRO_COMM_DIR)/compat/compat_snprintf.c \
				$(LIBRETRO_COMM_DIR)/compat/fopen_utf8.c \
				$(LIBRETRO_COMM_DIR)/encodings/encoding_utf.c \
				$(LIBRETRO_COMM_DIR)/file/file_path.c \
				$(LIBRETRO_COMM_DIR)/file/file_path_io.c \
				$(LIBRETRO_COMM_DIR)/file/retro_dirent.c \
				$(LIBRETRO_COMM_DIR)/streams/file_stream.c \
				$(LIBRETRO_COMM_DIR)/streams/file_stream_transforms.c \
				$(LIBRETRO_COMM_DIR)/string/stdstring.c \
				$(LIBRETRO_COMM_DIR)/vfs/vfs_implementation.c
ifdef _MSC_VER
SOURCES_C 		+= \
				$(LIBRETRO_COMM_DIR)/compat/compat_snprintf.c
endif
endif

# ZIP content: libretro-common's zlib-free zip reader and its link closure.
SOURCES_C 		+= \
				$(LIBRETRO_COMM_DIR)/compat/compat_strl.c \
				$(LIBRETRO_COMM_DIR)/encodings/encoding_crc32.c \
				$(LIBRETRO_COMM_DIR)/encodings/encoding_deflate.c \
				$(LIBRETRO_COMM_DIR)/features/features_cpu.c \
				$(LIBRETRO_COMM_DIR)/formats/zip/rzip_archive.c \
				$(LIBRETRO_COMM_DIR)/time/rtime.c
